{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "biome check ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "preview": "vite preview",
    "test": "vitest run --project node",
    "test:watch": "vitest",
    "test:jsdom": "vitest run --project jsdom",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project node --project jsdom --coverage"
  },
  "dependencies": {
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "taiyaku-wasm": "link:../crates/taiyaku-wasm/pkg"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
