# ---- Rust (if the core moves to WASM later) ---------------------------------
target/
**/*.rs.bk
Cargo.lock.orig

# ---- Misc -------------------------------------------------------------------
*.log
*.pid
*.seed
*.tgz
tmp/
temp/
scratch/

# Request logs from a reader session. The measurement belongs in docs/notes.md;
# the raw log is one session's working data and grows every run.
*.jsonl

# Visual brainstorming companion mockups, subagent review packages, and the
# progress ledger. Session working files.
.superpowers/

# Generated by scripts/build-wasm.sh from crates/taiyaku-wasm. A build
# artefact of a crate in this repository; committing it would be a second
# source of truth for what the binding does.
crates/taiyaku-wasm/pkg/

# Vitest browser mode writes a screenshot beside a test when it fails. Useful
# while debugging, never source.
web/src/__screenshots__/
