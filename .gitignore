# ---- Project-specific -------------------------------------------------------
# Manga archives are large and copyrighted. Never commit test fixtures.
# Point the test suite at a local corpus via TAIYAKU_CORPUS instead.
*.cbz
*.cbr
*.cb7
*.zip
# Anchored with a leading slash, and that is not cosmetic. A bare `corpus/`
# matches a directory of that name at **any** depth, so a new source file under
# `crates/taiyaku-cli/src/corpus/` would be left out silently, with no warning
# from `git add -A`: the local gate would pass because the file is on disk, and
# CI, cloning the repository without it, would fail. Only the top-level corpus
# directory is meant here.
#
# `fixtures/` and `testdata/` below are deliberately left unanchored: those names
# carry the copyright risk this block exists for wherever they appear, and the
# one legitimate `fixtures/` in the tree is re-admitted by name just below. If a
# source directory ever needs one of those names, re-admit it the same way rather
# than loosening the rule.
/corpus/
fixtures/
testdata/

# Credit-detection fixtures are the exception to the rule above: page indices
# and run shapes transcribed from docs/notes.md, never images, so there is
# nothing copyrighted to keep out. See crates/taiyaku-cli/src/credit_fixture.rs.
!crates/taiyaku-cli/fixtures/
!crates/taiyaku-cli/fixtures/**/*.json

# Generated alignment output and derived caches. Reproducible from the corpus.
taiyaku.json
*.taiyaku.json
.taiyaku-cache/
hashes/
thumbs/

# cargo-mutants scratch output. Always pass --output to keep it out of the
# tree anyway; this is the second line of defence, not the first.
mutants.out/

# Model weights fetched by the L2 phase-3 spike. The weights come from a GPL-3.0
# project whose author states he has no right to redistribute the training
# material; we fetch them, record the sha256, and never commit them. (`out/`
# below matches `spike/out/`; it is named here so a reader is not relying on a
# Node rule to cover a Rust directory.)
spike/models/
spike/out/

# Model weights for the L2 phase-3 measurement, fetched by
# scripts/fetch-model.sh and verified against a recorded sha256. From a GPL-3.0
# project whose training data may not be redistributed. Never committed.
models/

# Agent scratch. `.claude/worktrees/` holds a full checkout per agent, a
# `git add -A` away from being staged, since nothing else here ignores it.
.claude/

