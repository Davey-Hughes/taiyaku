# ---- Project-specific -------------------------------------------------------
# Manga archives are large and copyrighted. Never commit test fixtures.
# Point the test suite at a local corpus via TAIYAKU_CORPUS instead.
*.cbz
*.cbr
*.cb7
*.zip
corpus/
fixtures/
testdata/

# Generated alignment output and derived caches. Reproducible from the corpus.
taiyaku.json
*.taiyaku.json
.taiyaku-cache/
hashes/
thumbs/

# cargo-mutants scratch output. Always pass --output to keep it out of the
# tree anyway; this is the second line of defence, not the first.
mutants.out/

# Agent scratch. `.claude/worktrees/` holds a full checkout per agent and
# reached 7.4 GB on the branch that added this line — a `git add -A` away from
# being staged, since nothing else here was ignoring it.
.claude/

# ---- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Verification reports are large, self-contained, and reproducible from the
# corpus. Browser-automation scratch output likewise.
taiyaku-verify.html
*.verify.html
.playwright-mcp/

# ---- Editors ----------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.claude/settings.local.json

# ---- Python (aligner) -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

